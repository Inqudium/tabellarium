<?xml version="1.0" encoding="UTF-8"?>
<!--
    Logging for the test run only. Without this file Logback falls back to its BasicConfigurator - a
    DEBUG console appender - so every Kafka client and appender internal narrates the run. The tests
    attach the KafkaAppender under test programmatically (to the root logger or to a dedicated logger)
    and inspect only the appenders attached to IT, never the root's, so this console appender coexists
    with them.

    The events carry their data in two places a plain %msg pattern would hide: the SLF4J key-value pairs
    (rendered by %kvp - NONE = unquoted values) and the MDC entries, rendered by %mdc as key=value pairs
    - only the keys that are actually present. Same pattern as the test configurations of the other
    structured-logging modules in this reactor.
-->
<configuration>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg %kvp{NONE} [%mdc]%n</pattern>
        </encoder>
    </appender>

    <!-- The Kafka clients narrate every producer state change at INFO/DEBUG; the tests provoke plenty. -->
    <logger name="org.apache.kafka" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
